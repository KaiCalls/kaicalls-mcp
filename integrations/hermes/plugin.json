{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "kaicalls",
  "version": "1.1.0",
  "description": "A secretary for your business phone. Kai answers the calls you miss, takes the details and texts you; Hermes tells you what you missed, calls customers back and changes what Kai says.",
  "author": {
    "name": "KaiCalls",
    "url": "https://www.kaicalls.com"
  },
  "homepage": "https://www.kaicalls.com/?utm_source=hermes&utm_medium=plugin",
  "repository": "https://github.com/KaiCalls/kaicalls-mcp",
  "license": "MIT",
  "keywords": [
    "phone",
    "business-phone",
    "answering",
    "missed-calls",
    "voicemail",
    "leads",
    "sms",
    "kaicalls"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "config_schema": {
        "api_key": {
          "type": "secret",
          "env": "KAICALLS_API_KEY",
          "description": "Your KaiCalls key (starts with kc_live_). Create one at kaicalls.com under Settings > API Keys."
        }
      },
      "servers": {
        "kaicalls": {
          "trust": "untrusted"
        }
      }
    }
  }
}
