{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.kaicalls/kaicalls",
  "title": "KaiCalls",
  "description": "AI receptionist + business phone line: get a number, answer missed calls, read calls, text leads.",
  "version": "1.1.0",
  "websiteUrl": "https://www.kaicalls.com?utm_source=mcp_registry&utm_medium=directory",
  "repository": {
    "url": "https://github.com/KaiCalls/kaicalls-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/KaiCalls/kaicalls-mcp/main/assets/logo-400.png",
      "mimeType": "image/png",
      "sizes": ["400x400"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://www.kaicalls.com/api/mcp",
      "headers": [
        {
          "name": "X-KaiCalls-API-Key",
          "description": "Optional KaiCalls API key (kc_live_...) from Settings > API Keys. Omit it to sign in with OAuth 2.1 instead.",
          "isRequired": false,
          "isSecret": true
        }
      ]
    },
    {
      "type": "streamable-http",
      "url": "https://www.kaicalls.com/api/mcp/acquisition"
    }
  ]
}
